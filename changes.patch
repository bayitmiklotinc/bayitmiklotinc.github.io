+  border-top: 1px solid var(--stone);
+  scroll-margin-top: 130px;   /* keeps headings clear of the sticky header */
+}
+
+.policy-section h2 { font-size: 1.6rem; }
+.policy-section h3 { font-size: 1.15rem; margin-top: 1.6em; }
+.policy-top { font-size: 0.85rem; margin-top: 1.4em; }
+
+@media (max-width: 900px) {
+  .policy-section { scroll-margin-top: 100px; }
+}
