+  gap: 6px 18px;
+  font-size: 0.78rem;
+}
+
+.footer-policies a { color: var(--slate); }
+.footer-policies a:hover { color: var(--teal); }
+
+.footer-cards {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.footer-cards-label {
+  font-size: 0.74rem;
+  color: var(--taupe);
+  margin-right: 4px;
+}
+
+.footer-cards img {
+  width: 39px;
+  height: 25px;
+}
+
+/* ---------- Policies page ---------- */
+
+.policy-page h1 { font-size: clamp(1.9rem, 3.4vw, 2.5rem); }
+.policy-page .policy-updated { color: var(--taupe); font-size: 0.9rem; }
+.policy-page ul.lead-line li { font-weight: 400; }
+
+.policy-toc {
+  background: var(--cream);
+  border: 1.5px solid var(--stone);
+  border-radius: 14px;
+  padding: 18px 26px;
+  margin: 1.6em 0 0.6em;
+}
+
+.policy-toc ol { margin: 0; padding-left: 1.2em; }
+.policy-toc li { margin: 0.25em 0; }
+
+.policy-section {
+  padding-top: 2.2em;
